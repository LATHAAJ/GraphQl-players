{
  "name": "graphql-players-docs",
  "version": "1.0.0",
  "description": "GraphQL Players API Documentation",
  "scripts": {
    "docs": "graphql-markdown graphql-to-doc --schema ./src/main/resources/graphql/schema.graphqls --root ./docs --force",
    "docs:generate": "graphql-markdown graphql-to-doc --schema ./src/main/resources/graphql/schema.graphqls --root ./docs --force --pretty",
    "docs:manual": "node generate-docs-manual.js"
  },
  "devDependencies": {
    "@graphql-markdown/cli": "^1.0.0-alpha.0",
    "@graphql-tools/graphql-file-loader": "^7.0.0",
    "@graphql-tools/load": "^7.0.0",
    "graphql": "^16.0.0"
  }
}
